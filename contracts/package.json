{
  "name": "@monocinema/contracts",
  "version": "1.0.0",
  "description": "Protobuf defenitions for TypeScript files",
  "main": "index.js",
  "scripts": {
    "generate": "npx protoc -I ./proto ./proto/*.proto --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit"
  },
  "fies": [
    "proto",
    "gen"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.1.11",
    "rxjs": "^7.8.2"
  }
}
