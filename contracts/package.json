{
  "name": "@monocinema/contracts",
  "version": "1.0.1",
  "description": "Protobuf definitions for TypeScript files",
  "main": "index.js",
  "scripts": {
    "generate": "protoc -I ./proto ./proto/*.proto --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit"
  },
  "files": [
    "proto",
    "gen"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.1.11",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "protoc": "^33.2.0",
    "ts-proto": "^2.10.1"
  }
}
